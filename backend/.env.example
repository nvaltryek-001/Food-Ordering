# Copy to backend/.env — every value is optional.
PORT=5000
# REQUIRED in production: a long random string used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=604800
# Comma-separated origins allowed to call the API from another domain.
CLIENT_URL=http://localhost:5173,http://localhost:5000
# Where the JSON database lives (default: backend/data/runtime/db.json).
# DB_PATH=/var/data/foodsense.json
TABLE_COUNT=20
# Optional: use the TensorFlow Lite review model in /ai (falls back to the built-in model).
# AI_SERVICE_URL=http://127.0.0.1:8000
LOG_REQUESTS=true
