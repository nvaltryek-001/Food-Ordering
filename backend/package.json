{
  "name": "foodsense-backend",
  "version": "2.0.0",
  "private": true,
  "description": "FoodSense AI — REST + realtime API for QR table ordering and AI review analysis",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "data:menu": "node scripts/build-menu.js",
    "data:train": "node scripts/train-sentiment.js",
    "data": "npm run data:menu && npm run data:train",
    "seed": "node scripts/seed.js --force",
    "test": "node --test test/*.test.js"
  }
}
