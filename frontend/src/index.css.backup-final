@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap");

:root {
  --orange: #ff5a16;
  --orange-dark: #e94708;
  --orange-light: #fff1ea;
  --dark: #171717;
  --dark-2: #292929;
  --text: #252525;
  --muted: #747474;
  --border: #e9e9e9;
  --background: #f7f7f5;
  --white: #ffffff;
  --green: #16a66b;
  --green-light: #e9faf2;
  --red: #ef4444;
  --yellow: #f59e0b;
  --shadow: 0 15px 40px rgba(20, 20, 20, 0.07);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: "Inter", sans-serif;
  color: var(--text);
  background: var(--background);
}

button,
input,
textarea {
  font-family: inherit;
}

button {
  cursor: pointer;
}

a {
  text-decoration: none;
  color: inherit;
}

img {
  display: block;
  max-width: 100%;
}

/* ============================================================
   GLOBAL
   ============================================================ */

.app-shell {
  min-height: 100vh;
  padding-bottom: 70px;
}

.main-content {
  min-height: calc(100vh - 80px);
}

.topbar {
  height: 78px;
  padding: 0 6%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 100;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.brand-icon {
  width: 45px;
  height: 45px;
  background: var(--orange);
  color: white;
  border-radius: 13px;
  display: grid;
  place-items: center;
}

.brand-name {
  font-weight: 800;
  font-size: 19px;
  letter-spacing: -0.5px;
}

.brand-name span,
.manager-brand span {
  color: var(--orange);
}

.brand-tagline {
  font-size: 10px;
  color: var(--muted);
  margin-top: 2px;
}

.desktop-nav {
  display: flex;
  gap: 30px;
  align-items: center;
}

.desktop-nav a {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #555;
  font-size: 14px;
  font-weight: 600;
  transition: 0.2s;
}

.desktop-nav a:hover {
  color: var(--orange);
}

.top-actions {
  display: flex;
  gap: 10px;
  align-items: center;
}

.icon-button,
.avatar-button {
  width: 42px;
  height: 42px;
  border: 1px solid var(--border);
  background: white;
  border-radius: 12px;
  display: grid;
  place-items: center;
  color: #444;
  position: relative;
}

.cart-button:hover,
.avatar-button:hover {
  color: var(--orange);
  border-color: #ffd2c1;
}

.notification-badge,
.bottom-cart small {
  position: absolute;
  background: var(--orange);
  color: white;
  min-width: 19px;
  height: 19px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 10px;
  font-weight: 800;
  top: -5px;
  right: -5px;
}

.mobile-menu-button {
  display: none;
  background: transparent;
  border: 0;
}

.mobile-menu {
  display: none;
}

/* ============================================================
   BUTTONS
   ============================================================ */

.primary-button,
.secondary-button,
.outline-button,
.white-button,
.danger-button,
.add-button,
.primary-small-button {
  border: 0;
  border-radius: 11px;
  min-height: 45px;
  padding: 0 19px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  font-size: 14px;
  transition: 0.2s ease;
}

.primary-button {
  color: white;
  background: var(--orange);
  box-shadow: 0 7px 18px rgba(255, 90, 22, 0.22);
}

.primary-button:hover {
  background: var(--orange-dark);
  transform: translateY(-1px);
}

.secondary-button,
.outline-button {
  background: white;
  border: 1px solid var(--border);
  color: var(--dark);
}

.secondary-button:hover,
.outline-button:hover {
  border-color: var(--orange);
  color: var(--orange);
}

.white-button {
  background: white;
  color: var(--orange);
}

.full-button {
  width: 100%;
}

.danger-button {
  background: #fff0f0;
  color: var(--red);
  border: 1px solid #ffd6d6;
}

.text-button {
  background: transparent;
  border: 0;
  color: var(--orange);
  font-size: 12px;
}

/* ============================================================
   HERO
   ============================================================ */

.hero {
  min-height: 610px;
  padding: 75px 8%;
  background:
    radial-gradient(circle at 75% 40%, rgba(255, 90, 22, 0.13), transparent 32%),
    linear-gradient(135deg, #fff 0%, #fff8f4 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
}

.hero-content {
  max-width: 600px;
}

.hero-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--orange);
  background: var(--orange-light);
  padding: 9px 14px;
  border-radius: 50px;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 20px;
}

.hero h1 {
  font-size: clamp(45px, 6vw, 76px);
  line-height: 0.98;
  letter-spacing: -4px;
  margin: 0;
  font-weight: 800;
}

.hero h1 span {
  color: var(--orange);
}

.hero p {
  color: var(--muted);
  font-size: 17px;
  line-height: 1.7;
  max-width: 540px;
  margin: 25px 0;
}

.hero-buttons {
  display: flex;
  gap: 12px;
}

.hero-stats {
  display: flex;
  gap: 45px;
  margin-top: 48px;
}

.hero-stats div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.hero-stats strong {
  font-size: 20px;
}

.hero-stats span {
  color: var(--muted);
  font-size: 11px;
}

.hero-food {
  width: 46%;
  max-width: 560px;
  position: relative;
}

.hero-food img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: 50%;
  box-shadow: 0 30px 80px rgba(80, 40, 20, 0.18);
  border: 13px solid rgba(255, 255, 255, 0.85);
}

.hero-glow {
  position: absolute;
  width: 90%;
  height: 90%;
  background: rgba(255, 90, 22, 0.15);
  filter: blur(50px);
  border-radius: 50%;
  left: 5%;
  top: 5%;
}

.floating-score-card {
  position: absolute;
  bottom: 12%;
  left: -8%;
  background: white;
  border-radius: 17px;
  padding: 15px 19px;
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  gap: 11px;
}

.score-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  color: var(--green);
  background: var(--green-light);
}

.floating-score-card small,
.floating-score-card strong {
  display: block;
}

.floating-score-card small {
  color: var(--muted);
  font-size: 10px;
}

.floating-score-card strong {
  margin-top: 3px;
}

/* ============================================================
   SECTIONS
   ============================================================ */

.section-container {
  padding: 85px 8%;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 35px;
}

.section-heading h2,
.section-heading p {
  margin: 0;
}

.section-heading h2 {
  font-size: 34px;
  margin-top: 6px;
  letter-spacing: -1px;
}

.section-heading p {
  max-width: 300px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

.section-eyebrow {
  color: var(--orange);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.6px;
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.process-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 28px;
  position: relative;
}

.process-number {
  position: absolute;
  right: 18px;
  top: 16px;
  color: #ddd;
  font-size: 13px;
  font-weight: 800;
}

.process-icon {
  width: 50px;
  height: 50px;
  border-radius: 14px;
  background: var(--orange-light);
  color: var(--orange);
  display: grid;
  place-items: center;
  margin-bottom: 20px;
}

.process-card h3 {
  margin: 0 0 9px;
}

.process-card p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
  margin: 0;
}

.ai-banner {
  margin: 10px 8% 80px;
  border-radius: 25px;
  padding: 40px 45px;
  background: linear-gradient(120deg, #151515, #292929);
  color: white;
  display: flex;
  align-items: center;
  gap: 22px;
}

.ai-banner-icon {
  width: 65px;
  height: 65px;
  flex-shrink: 0;
  background: rgba(255, 90, 22, 0.17);
  color: var(--orange);
  border-radius: 17px;
  display: grid;
  place-items: center;
}

.ai-banner span {
  color: var(--orange);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.ai-banner h2 {
  margin: 5px 0;
}

.ai-banner p {
  margin: 0;
  color: #aaa;
  font-size: 13px;
}

.ai-banner .white-button {
  margin-left: auto;
  white-space: nowrap;
}

/* ============================================================
   AUTH
   ============================================================ */

.auth-page {
  min-height: calc(100vh - 78px);
  display: grid;
  place-items: center;
  padding: 40px 20px;
  background:
    radial-gradient(circle at 30% 20%, rgba(255, 90, 22, 0.09), transparent 35%),
    var(--background);
}

.auth-card {
  width: min(450px, 100%);
  background: white;
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 38px;
  box-shadow: var(--shadow);
}

.auth-logo {
  width: 58px;
  height: 58px;
  border-radius: 16px;
  background: var(--orange);
  color: white;
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
}

.auth-card h1 {
  text-align: center;
  margin: 0;
}

.auth-card > p {
  text-align: center;
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 30px;
}

.auth-card form label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  margin: 16px 0 7px;
}

.input-wrapper {
  height: 48px;
  border: 1px solid var(--border);
  border-radius: 10px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 13px;
  color: #999;
}

.input-wrapper:focus-within {
  border-color: var(--orange);
}

.input-wrapper input {
  border: 0;
  outline: 0;
  width: 100%;
  font-size: 13px;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 13px 0 20px;
}

.checkbox-label {
  display: flex !important;
  align-items: center;
  gap: 5px;
  margin: 0 !important;
  font-size: 11px !important;
  font-weight: 500 !important;
}

.divider {
  margin: 25px 0 18px;
  border-top: 1px solid var(--border);
  text-align: center;
}

.divider span {
  background: white;
  padding: 0 10px;
  position: relative;
  top: -9px;
  color: #999;
  font-size: 11px;
}

.social-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.social-buttons button {
  height: 44px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: white;
  font-weight: 600;
}

.google-icon {
  color: #4285f4;
  font-weight: 900;
}

.auth-footer {
  margin: 22px 0 0 !important;
  font-size: 12px !important;
}

.auth-footer a {
  color: var(--orange);
  font-weight: 700;
}

/* ============================================================
   SCAN
   ============================================================ */

.center-page {
  min-height: calc(100vh - 78px);
  display: grid;
  place-items: center;
  padding: 50px 20px;
}

.scan-card {
  background: white;
  width: min(480px, 100%);
  border: 1px solid var(--border);
  border-radius: 25px;
  padding: 35px;
  text-align: center;
  box-shadow: var(--shadow);
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 25px;
}

.scan-icon {
  width: 60px;
  height: 60px;
  margin: 0 auto 17px;
  border-radius: 17px;
  background: var(--orange-light);
  color: var(--orange);
  display: grid;
  place-items: center;
}

.scan-card h1 {
  margin: 0 0 8px;
}

.scan-card > p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

.qr-box {
  height: 270px;
  margin: 25px 0;
  background: #f4f4f4;
  border-radius: 17px;
  display: grid;
  place-items: center;
  position: relative;
  overflow: hidden;
}

.qr-pattern {
  width: 185px;
  height: 185px;
  background:
    linear-gradient(90deg, #111 10px, transparent 10px) 0 0 / 35px 35px,
    linear-gradient(#111 10px, transparent 10px) 0 0 / 35px 35px,
    white;
  border: 10px solid white;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
  position: relative;
  display: grid;
  place-items: center;
}

.qr-pattern span {
  background: white;
  border: 3px solid #111;
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  font-weight: 900;
}

.qr-square {
  position: absolute;
  width: 43px;
  height: 43px;
  background: white;
  border: 8px solid #111;
}

.qr-square.one {
  left: -2px;
  top: -2px;
}

.qr-square.two {
  right: -2px;
  top: -2px;
}

.qr-square.three {
  left: -2px;
  bottom: -2px;
}

.scan-line {
  position: absolute;
  color: var(--orange);
  animation: scan 2s infinite;
}

@keyframes scan {
  0%, 100% {
    transform: translateY(-80px);
    opacity: 0.3;
  }
  50% {
    transform: translateY(80px);
    opacity: 1;
  }
}

.manual-table {
  margin-top: 20px;
  text-align: left;
}

.manual-table > span {
  display: block;
  font-size: 11px;
  font-weight: 700;
  margin-bottom: 7px;
}

.table-input {
  display: flex;
  gap: 7px;
}

.table-input input {
  flex: 1;
  height: 44px;
  border: 1px solid var(--border);
  border-radius: 9px;
  padding: 0 12px;
}

.table-input button {
  border: 0;
  background: #222;
  color: white;
  padding: 0 17px;
  border-radius: 9px;
  font-weight: 700;
}

/* ============================================================
   MENU
   ============================================================ */

.page-container {
  width: min(1250px, 90%);
  margin: 0 auto;
  padding: 50px 0 70px;
}

.page-container.narrow {
  max-width: 750px;
}

.menu-header,
.page-title-row,
.content-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
}

.menu-header h1,
.page-title-row h1,
.content-heading h1 {
  font-size: 38px;
  margin: 5px 0 8px;
  letter-spacing: -1.5px;
}

.menu-header p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.ai-status,
.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--green-light);
  color: var(--green);
  border-radius: 50px;
  padding: 8px 12px;
  font-size: 10px;
  font-weight: 800;
}

.search-bar {
  margin: 28px 0 17px;
  height: 52px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 12px;
  display: flex;
  align-items: center;
  padding: 0 16px;
  color: #999;
}

.search-bar input {
  width: 100%;
  border: 0;
  outline: 0;
  padding-left: 10px;
  font-size: 13px;
}

.category-row {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 8px;
}

.category-row button {
  border: 1px solid var(--border);
  background: white;
  padding: 9px 16px;
  border-radius: 50px;
  white-space: nowrap;
  font-size: 11px;
  font-weight: 700;
}

.category-row button.active {
  background: #222;
  color: white;
  border-color: #222;
}

.ranking-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 32px 0 18px;
}

.ranking-heading > div {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--orange);
}

.ranking-heading h2 {
  margin: 0;
  color: var(--text);
  font-size: 19px;
}

.ranking-heading > span {
  color: var(--muted);
  font-size: 11px;
}

.food-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.food-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 17px;
  overflow: hidden;
  transition: 0.25s;
}

.food-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}

.food-image-wrapper {
  height: 210px;
  position: relative;
  overflow: hidden;
}

.food-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.rank-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: white;
  color: var(--orange);
  border-radius: 8px;
  padding: 7px 9px;
  font-size: 10px;
  font-weight: 800;
  display: flex;
  gap: 4px;
  align-items: center;
}

.heart-button {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 0;
  background: white;
  color: #777;
  display: grid;
  place-items: center;
  position: absolute;
  top: 12px;
  right: 12px;
}

.heart-button:hover {
  color: var(--orange);
}

.heart-button.large {
  width: 44px;
  height: 44px;
}

.food-info {
  padding: 17px;
}

.food-category {
  color: var(--orange);
  text-transform: uppercase;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.8px;
}

.food-info h3 {
  margin: 5px 0 7px;
  font-size: 16px;
}

.rating-row,
.large-rating {
  display: flex;
  align-items: center;
  gap: 5px;
  color: var(--yellow);
}

.rating-row strong,
.large-rating strong {
  color: var(--text);
  font-size: 12px;
}

.rating-row span,
.large-rating span {
  color: #999;
  font-size: 10px;
}

.food-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 15px;
}

.food-price {
  font-size: 17px;
}

.add-button {
  min-height: 35px;
  padding: 0 12px;
  color: white;
  background: var(--orange);
  font-size: 11px;
}

/* ============================================================
   FOOD DETAILS
   ============================================================ */

.detail-container {
  width: min(1050px, 90%);
  margin: 0 auto;
  padding: 45px 0 80px;
}

.food-detail {
  background: white;
  border-radius: 23px;
  border: 1px solid var(--border);
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1fr;
}

.detail-image {
  min-height: 600px;
  position: relative;
}

.detail-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.detail-image .heart-button {
  top: 20px;
  right: 20px;
}

.detail-info {
  padding: 45px;
}

.detail-info h1 {
  font-size: 42px;
  margin: 10px 0;
  letter-spacing: -2px;
}

.loved-badge {
  display: inline-flex;
  gap: 6px;
  align-items: center;
  background: var(--green-light);
  color: var(--green);
  padding: 7px 11px;
  border-radius: 50px;
  font-size: 10px;
  font-weight: 800;
  margin-top: 13px;
}

.detail-description {
  color: var(--muted);
  line-height: 1.7;
  font-size: 13px;
  margin: 25px 0 18px;
}

.tag-list {
  display: flex;
  gap: 7px;
}

.tag-list span {
  background: var(--orange-light);
  color: var(--orange);
  padding: 7px 11px;
  border-radius: 50px;
  font-size: 10px;
  font-weight: 700;
}

.detail-price {
  font-size: 28px;
  font-weight: 800;
  margin: 28px 0 17px;
}

.review-preview {
  border-top: 1px solid var(--border);
  margin-top: 30px;
  padding-top: 20px;
}

.review-header {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
}

.review-header span {
  color: var(--orange);
}

.review-item {
  display: flex;
  gap: 10px;
  margin-top: 15px;
}

.review-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #222;
  color: white;
  display: grid;
  place-items: center;
  font-size: 9px;
  font-weight: 800;
  flex-shrink: 0;
}

.stars {
  color: var(--orange);
  font-size: 11px;
  letter-spacing: 1px;
}

.review-item p {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.5;
  margin: 5px 0;
}

/* ============================================================
   CART
   ============================================================ */

.cart-layout {
  display: grid;
  grid-template-columns: 1.7fr 0.9fr;
  gap: 25px;
  margin-top: 30px;
}

.cart-items {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.cart-item {
  background: white;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 13px;
  display: flex;
  align-items: center;
  gap: 15px;
}

.cart-item img {
  width: 85px;
  height: 85px;
  object-fit: cover;
  border-radius: 12px;
}

.cart-item-info {
  flex: 1;
}

.cart-item-info span {
  color: var(--orange);
  font-size: 9px;
  text-transform: uppercase;
  font-weight: 800;
}

.cart-item-info h3 {
  margin: 4px 0;
  font-size: 15px;
}

.cart-item-info strong {
  font-size: 13px;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 4px;
}

.quantity-control button {
  width: 27px;
  height: 27px;
  border: 0;
  background: #f4f4f4;
  border-radius: 6px;
  display: grid;
  place-items: center;
}

.quantity-control span {
  font-size: 12px;
  font-weight: 800;
}

.delete-button {
  background: transparent;
  border: 0;
  color: #999;
}

.delete-button:hover {
  color: var(--red);
}

.summary-card,
.payment-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 25px;
  height: fit-content;
}

.summary-card h2,
.payment-card h2 {
  font-size: 18px;
  margin-top: 0;
}

.summary-line,
.summary-total,
.checkout-total {
  display: flex;
  justify-content: space-between;
  margin: 14px 0;
}

.summary-line {
  color: var(--muted);
  font-size: 12px;
}

.summary-line strong {
  color: var(--text);
}

.summary-divider {
  border-top: 1px solid var(--border);
  margin: 18px 0;
}

.summary-total {
  font-size: 15px;
  margin-bottom: 20px;
}

.summary-total strong {
  font-size: 19px;
}

/* ============================================================
   CHECKOUT
   ============================================================ */

.checkout-header {
  margin: 20px 0;
}

.checkout-header h1 {
  font-size: 38px;
  margin: 4px 0;
}

.payment-option {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 12px;
  margin: 10px 0;
}

.payment-option.selected {
  border-color: var(--orange);
  background: var(--orange-light);
}

.payment-option input {
  accent-color: var(--orange);
}

.payment-option div {
  flex: 1;
}

.payment-option strong,
.payment-option span {
  display: block;
}

.payment-option strong {
  font-size: 13px;
}

.payment-option span {
  color: var(--muted);
  font-size: 10px;
  margin-top: 3px;
}

.checkout-total {
  border-top: 1px solid var(--border);
  padding-top: 18px;
  margin-top: 22px;
  font-size: 16px;
}

.checkout-total strong {
  font-size: 21px;
}

.secure-note {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6px;
  color: var(--green);
  font-size: 10px;
  margin-top: 14px;
}

/* ============================================================
   SUCCESS
   ============================================================ */

.success-page,
.analysis-page,
.review-page {
  min-height: calc(100vh - 78px);
  padding: 50px 20px;
  display: grid;
  place-items: center;
}

.success-card,
.analysis-card,
.review-card {
  width: min(600px, 100%);
  background: white;
  border: 1px solid var(--border);
  border-radius: 25px;
  padding: 40px;
  text-align: center;
  box-shadow: var(--shadow);
}

.success-icon {
  width: 90px;
  height: 90px;
  background: var(--green-light);
  color: var(--green);
  border-radius: 50%;
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
}

.success-card h1,
.analysis-card h1,
.review-card h1 {
  font-size: 31px;
  margin: 8px 0;
}

.success-card > p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

.order-id {
  background: #f7f7f7;
  border-radius: 12px;
  padding: 13px;
  margin: 22px 0;
  text-align: left;
}

.order-id span,
.order-id strong {
  display: block;
}

.order-id span {
  color: var(--muted);
  font-size: 9px;
}

.order-id strong {
  margin-top: 3px;
  font-size: 14px;
}

.estimate {
  display: flex;
  align-items: center;
  gap: 10px;
  justify-content: center;
  margin-bottom: 25px;
  color: var(--orange);
}

.estimate div {
  text-align: left;
}

.estimate span,
.estimate strong {
  display: block;
}

.estimate span {
  color: var(--muted);
  font-size: 9px;
}

.estimate strong {
  font-size: 12px;
}

/* ============================================================
   ORDER TIMELINE
   ============================================================ */

.timeline-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 28px;
  margin: 25px 0;
}

.timeline-step {
  display: flex;
  gap: 15px;
  position: relative;
  padding-bottom: 32px;
}

.timeline-step:last-child {
  padding-bottom: 0;
}

.timeline-step:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 16px;
  top: 34px;
  bottom: 0;
  width: 2px;
  background: #ddd;
}

.timeline-dot {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: var(--green);
  color: white;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.timeline-step.current {
  background: var(--orange-light);
  padding: 14px;
  margin-left: -14px;
  margin-right: -14px;
  border-radius: 12px;
}

.timeline-step.current .timeline-dot {
  background: var(--orange);
}

.timeline-step strong,
.timeline-step span,
.timeline-step p {
  display: block;
}

.timeline-step strong {
  font-size: 13px;
}

.timeline-step span {
  color: var(--muted);
  font-size: 9px;
  margin-top: 3px;
}

.timeline-step p {
  color: var(--muted);
  font-size: 10px;
  margin: 6px 0 0;
}

/* ============================================================
   REVIEW
   ============================================================ */

.review-food {
  display: flex;
  align-items: center;
  gap: 13px;
  background: #fafafa;
  padding: 12px;
  border-radius: 12px;
  text-align: left;
  margin: 23px 0;
}

.review-food img {
  width: 60px;
  height: 60px;
  object-fit: cover;
  border-radius: 10px;
}

.review-food strong,
.review-food span {
  display: block;
}

.review-food strong {
  font-size: 14px;
}

.review-food span {
  color: var(--muted);
  font-size: 10px;
  margin-top: 4px;
}

.star-selector {
  display: flex;
  justify-content: center;
  gap: 4px;
}

.star-selector button {
  border: 0;
  background: transparent;
  color: #ddd;
}

.star-selector button.selected {
  color: var(--orange);
}

.rating-label {
  color: var(--orange);
  font-weight: 800;
  font-size: 13px;
  margin: 7px 0 25px;
}

.review-card > label {
  display: block;
  text-align: left;
  font-size: 11px;
  font-weight: 700;
  margin: 15px 0 7px;
}

.review-card textarea {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 11px;
  padding: 12px;
  resize: vertical;
  outline: 0;
  font-size: 12px;
}

.review-card textarea:focus {
  border-color: var(--orange);
}

.photo-upload {
  display: flex;
  gap: 8px;
}

.photo-preview,
.photo-upload button {
  width: 65px;
  height: 65px;
  border-radius: 10px;
}

.photo-preview {
  overflow: hidden;
}

.photo-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-upload button {
  border: 1px dashed #bbb;
  background: white;
  color: #888;
}

/* ============================================================
   AI ANALYSIS
   ============================================================ */

.ai-robot {
  width: 90px;
  height: 90px;
  border-radius: 28px;
  background: #eef6ff;
  color: #2674d9;
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
}

.sentiment-result {
  margin: 22px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
}

.sentiment-result strong {
  font-size: 22px;
}

.sentiment-result span {
  color: var(--muted);
  font-size: 10px;
}

.sentiment-result.positive {
  color: var(--green);
}

.sentiment-result.neutral {
  color: var(--yellow);
}

.sentiment-result.negative {
  color: var(--red);
}

.analysis-breakdown {
  background: #fafafa;
  border-radius: 13px;
  padding: 13px 17px;
}

.analysis-breakdown div {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid #eee;
}

.analysis-breakdown div:last-child {
  border-bottom: 0;
}

.analysis-breakdown span {
  color: var(--muted);
  font-size: 11px;
}

.analysis-breakdown strong {
  color: var(--green);
  font-size: 11px;
}

.review-quote {
  color: #666;
  font-size: 12px;
  line-height: 1.6;
  font-style: italic;
  margin: 20px 0;
}

.score-update {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 25px;
  padding: 20px;
  background: var(--green-light);
  border-radius: 15px;
  color: var(--green);
}

.score-update div span,
.score-update div strong {
  display: block;
}

.score-update span {
  font-size: 9px;
  color: #57866f;
}

.score-update strong {
  font-size: 20px;
}

.success-message {
  margin: 15px 0;
  padding: 12px;
  background: var(--green-light);
  color: var(--green);
  border-radius: 10px;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
}

/* ============================================================
   EMPTY / PROFILE
   ============================================================ */

.empty-state {
  background: white;
  border: 1px solid var(--border);
  border-radius: 20px;
  min-height: 330px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #aaa;
  text-align: center;
  gap: 9px;
}

.empty-state h2 {
  color: var(--text);
  margin: 5px 0;
}

.empty-state p {
  color: var(--muted);
  font-size: 12px;
}

.profile-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 40px;
  text-align: center;
}

.profile-avatar {
  width: 95px;
  height: 95px;
  margin: 0 auto 17px;
  background: var(--orange-light);
  color: var(--orange);
  border-radius: 50%;
  display: grid;
  place-items: center;
}

.profile-card h1 {
  margin: 0;
}

.profile-card > p {
  color: var(--muted);
  font-size: 12px;
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 30px 0;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 18px 0;
}

.profile-stats div {
  border-right: 1px solid var(--border);
}

.profile-stats div:last-child {
  border: 0;
}

.profile-stats strong,
.profile-stats span {
  display: block;
}

.profile-stats strong {
  font-size: 20px;
}

.profile-stats span {
  color: var(--muted);
  font-size: 9px;
  margin-top: 4px;
}

/* ============================================================
   BOTTOM NAV
   ============================================================ */

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 65px;
  background: rgba(255,255,255,0.97);
  backdrop-filter: blur(15px);
  border-top: 1px solid var(--border);
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60px;
}

.bottom-nav a {
  color: #777;
  font-size: 9px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  position: relative;
}

.bottom-nav a:hover {
  color: var(--orange);
}

.bottom-cart small {
  top: -7px;
  right: 1px;
}

/* ============================================================
   MANAGER
   ============================================================ */

.manager-shell {
  min-height: 100vh;
  background: #f6f7f9;
  display: flex;
}

.manager-sidebar {
  width: 245px;
  flex-shrink: 0;
  background: #151515;
  color: white;
  padding: 25px 17px;
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  bottom: 0;
}

.manager-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 8px 28px;
}

.manager-brand strong,
.manager-brand small {
  display: block;
}

.manager-brand strong {
  font-size: 14px;
}

.manager-brand small {
  color: #777;
  font-size: 8px;
  margin-top: 3px;
}

.manager-nav-label {
  color: #666;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1.4px;
  padding: 0 11px 10px;
}

.manager-sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.manager-sidebar nav a,
.manager-bottom a {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 12px;
  border-radius: 9px;
  color: #aaa;
  font-size: 11px;
  font-weight: 600;
}

.manager-sidebar nav a:hover,
.manager-sidebar nav a.active {
  background: #292929;
  color: white;
}

.manager-sidebar nav a:hover svg {
  color: var(--orange);
}

.manager-bottom {
  margin-top: auto;
  border-top: 1px solid #292929;
  padding-top: 15px;
}

.manager-main {
  margin-left: 245px;
  width: calc(100% - 245px);
}

.manager-topbar {
  min-height: 100px;
  background: white;
  border-bottom: 1px solid var(--border);
  padding: 20px 35px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.manager-topbar h1 {
  margin: 4px 0 0;
  font-size: 24px;
}

.manager-actions {
  display: flex;
  align-items: center;
  gap: 17px;
}

.manager-user {
  display: flex;
  align-items: center;
  gap: 8px;
}

.small-avatar {
  width: 35px;
  height: 35px;
  border-radius: 50%;
  background: var(--orange);
  color: white;
  display: grid;
  place-items: center;
  font-weight: 800;
}

.manager-user strong,
.manager-user span {
  display: block;
}

.manager-user strong {
  font-size: 11px;
}

.manager-user span {
  color: var(--muted);
  font-size: 8px;
  margin-top: 2px;
}

.manager-content {
  padding: 30px 35px 70px;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
  margin-bottom: 20px;
}

.metric-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 19px;
  display: flex;
  align-items: center;
  gap: 13px;
}

.metric-icon {
  width: 43px;
  height: 43px;
  background: var(--orange-light);
  color: var(--orange);
  border-radius: 11px;
  display: grid;
  place-items: center;
}

.metric-card span,
.metric-card strong,
.metric-card small {
  display: block;
}

.metric-card span {
  color: var(--muted);
  font-size: 9px;
}

.metric-card strong {
  font-size: 19px;
  margin: 3px 0;
}

.metric-card small {
  color: var(--green);
  font-size: 9px;
  font-weight: 800;
}

.manager-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 18px;
  margin-bottom: 18px;
}

.manager-panel {
  background: white;
  border: 1px solid var(--border);
  border-radius: 15px;
  padding: 20px;
  min-width: 0;
}

.manager-panel.large {
  min-width: 0;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 17px;
}

.panel-header h2 {
  font-size: 14px;
  margin: 0;
}

.panel-header span {
  color: var(--muted);
  font-size: 9px;
  display: block;
  margin-top: 4px;
}

.panel-header a {
  color: var(--orange);
  font-size: 10px;
  font-weight: 800;
}

.table-wrapper {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 10px;
}

th {
  background: #f7f7f7;
  color: #777;
  text-align: left;
  padding: 10px;
  font-size: 8px;
}

td {
  border-bottom: 1px solid #f0f0f0;
  padding: 11px 10px;
}

.status-pill.served {
  color: var(--green);
  background: var(--green-light);
}

.status-pill.preparing {
  color: var(--orange);
  background: var(--orange-light);
}

.status-pill.accepted {
  color: #2674d9;
  background: #eef6ff;
}

.status-pill.placed {
  color: #777;
  background: #f1f1f1;
}

.sentiment-chart {
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 20px;
  margin: 30px 0;
}

.donut {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  background: conic-gradient(
    var(--green) 0 72%,
    var(--yellow) 72% 90%,
    var(--red) 90% 100%
  );
  display: grid;
  place-items: center;
}

.donut::before {
  content: "";
  width: 93px;
  height: 93px;
  background: white;
  border-radius: 50%;
  position: absolute;
}

.donut div {
  position: relative;
  z-index: 2;
  text-align: center;
}

.donut strong,
.donut span {
  display: block;
}

.donut strong {
  font-size: 23px;
}

.donut span {
  color: var(--muted);
  font-size: 9px;
}

.legend {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.legend div {
  display: grid;
  grid-template-columns: 9px 1fr auto;
  gap: 6px;
  align-items: center;
  font-size: 10px;
}

.legend strong {
  margin-left: 20px;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.positive-dot {
  background: var(--green);
}

.neutral-dot {
  background: var(--yellow);
}

.negative-dot {
  background: var(--red);
}

.insight-box {
  background: var(--green-light);
  color: var(--green);
  border-radius: 9px;
  padding: 11px;
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 9px;
  line-height: 1.4;
}

.top-food-list,
.feedback-list,
.full-feedback-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.top-food {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px 0;
  border-bottom: 1px solid #f0f0f0;
}

.food-rank {
  width: 24px;
  font-size: 9px;
  color: #999;
}

.top-food img {
  width: 39px;
  height: 39px;
  border-radius: 8px;
  object-fit: cover;
}

.top-food > div {
  flex: 1;
}

.top-food strong,
.top-food span {
  display: block;
}

.top-food strong {
  font-size: 10px;
}

.top-food span {
  color: var(--muted);
  font-size: 8px;
  margin-top: 2px;
}

.top-food .food-score {
  color: var(--orange);
}

.feedback {
  display: flex;
  gap: 9px;
  padding: 8px 0;
  border-bottom: 1px solid #f0f0f0;
}

.feedback-avatar {
  width: 35px;
  height: 35px;
  border-radius: 50%;
  background: #eee;
  display: grid;
  place-items: center;
  font-size: 10px;
  font-weight: 800;
  flex-shrink: 0;
}

.feedback strong {
  font-size: 10px;
}

.feedback p {
  color: var(--muted);
  font-size: 9px;
  margin: 3px 0;
}

.content-heading {
  margin-bottom: 25px;
}

.live-indicator {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  color: var(--green);
  font-weight: 800;
}

.live-indicator span {
  width: 7px;
  height: 7px;
  background: var(--green);
  border-radius: 50%;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  50% {
    opacity: 0.3;
  }
}

.order-manager-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.manager-order-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 13px;
  padding: 17px;
  display: grid;
  grid-template-columns: 2fr 0.7fr 0.8fr 1fr;
  align-items: center;
  gap: 15px;
}

.order-main {
  display: flex;
  gap: 13px;
  align-items: center;
}

.order-number {
  color: var(--orange);
  font-weight: 800;
  font-size: 10px;
}

.order-main strong {
  font-size: 12px;
}

.order-main p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 9px;
}

.primary-small-button {
  min-height: 37px;
  font-size: 10px;
  background: var(--orange);
  color: white;
}

.manager-food-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.manager-food-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
}

.manager-food-image {
  height: 170px;
  position: relative;
}

.manager-food-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.manager-food-image span {
  position: absolute;
  left: 10px;
  top: 10px;
  background: white;
  color: var(--orange);
  padding: 6px 8px;
  border-radius: 7px;
  font-size: 9px;
  font-weight: 800;
}

.manager-food-card > div:last-child {
  padding: 14px;
}

.manager-food-card > div:last-child > span {
  color: var(--orange);
  font-size: 8px;
  text-transform: uppercase;
  font-weight: 800;
}

.manager-food-card h3 {
  font-size: 14px;
  margin: 5px 0;
}

.food-score-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.food-score-row strong {
  color: var(--orange);
  font-size: 11px;
}

.food-score-row span {
  color: var(--muted);
  font-size: 8px;
}

.manager-food-actions {
  display: flex;
  gap: 6px;
  margin-top: 13px;
}

.manager-food-actions button {
  flex: 1;
  border: 1px solid var(--border);
  background: white;
  border-radius: 7px;
  padding: 7px;
  font-size: 9px;
  font-weight: 700;
}

.review-dashboard,
.analytics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin-bottom: 18px;
}

.review-summary-card,
.analytics-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 22px;
}

.review-summary-card span,
.review-summary-card strong,
.review-summary-card small {
  display: block;
}

.review-summary-card span {
  color: var(--muted);
  font-size: 10px;
}

.review-summary-card strong {
  font-size: 29px;
  margin: 8px 0 3px;
}

.review-summary-card small {
  color: var(--muted);
  font-size: 8px;
}

.large-stars {
  font-size: 14px;
  margin-bottom: 8px;
}

.progress {
  height: 7px;
  border-radius: 50px;
  background: #eee;
  margin: 10px 0;
  overflow: hidden;
}

.progress span {
  display: block;
  height: 100%;
  background: var(--green);
}

.progress.negative span {
  background: var(--red);
}

.analytics-grid {
  grid-template-columns: repeat(4, 1fr);
}

.analytics-card span,
.analytics-card strong,
.analytics-card small {
  display: block;
}

.analytics-card span {
  color: var(--muted);
  font-size: 9px;
}

.analytics-card strong {
  font-size: 21px;
  margin: 8px 0 4px;
}

.analytics-card small {
  color: var(--green);
  font-size: 8px;
}

.fake-chart {
  height: 300px;
  display: flex;
  align-items: end;
  justify-content: space-around;
  gap: 25px;
  padding: 20px;
  border-bottom: 1px solid var(--border);
}

.fake-chart div {
  width: 8%;
  background: var(--orange);
  border-radius: 7px 7px 0 0;
  position: relative;
  min-height: 30px;
}

.fake-chart span {
  position: absolute;
  bottom: -22px;
  left: 50%;
  transform: translateX(-50%);
  color: var(--muted);
  font-size: 9px;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1050px) {
  .food-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .process-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero {
    padding-left: 6%;
    padding-right: 6%;
  }

  .manager-food-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .metric-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 800px) {
  .desktop-nav {
    display: none;
  }

  .mobile-menu-button {
    display: grid;
    place-items: center;
  }

  .mobile-menu {
    position: fixed;
    top: 78px;
    left: 0;
    right: 0;
    z-index: 99;
    background: white;
    border-bottom: 1px solid var(--border);
    padding: 15px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-menu a {
    padding: 13px;
    border-radius: 8px;
    font-size: 13px;
  }

  .mobile-menu a:hover {
    background: var(--orange-light);
    color: var(--orange);
  }

  .hero {
    flex-direction: column;
    text-align: center;
    padding-top: 55px;
  }

  .hero-content {
    max-width: 700px;
  }

  .hero p {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-buttons,
  .hero-stats {
    justify-content: center;
  }

  .hero-food {
    width: 70%;
    margin-top: 50px;
  }

  .food-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .detail-image {
    min-height: 400px;
  }

  .food-detail {
    grid-template-columns: 1fr;
  }

  .cart-layout,
  .manager-grid {
    grid-template-columns: 1fr;
  }

  .manager-sidebar {
    width: 75px;
  }

  .manager-sidebar .manager-brand > div:last-child,
  .manager-sidebar .manager-nav-label,
  .manager-sidebar nav a:not(:has(svg)),
  .manager-sidebar nav a {
    font-size: 0;
  }

  .manager-sidebar nav a svg {
    font-size: initial;
  }

  .manager-sidebar nav a,
  .manager-bottom a {
    justify-content: center;
  }

  .manager-brand {
    justify-content: center;
  }

  .manager-main {
    margin-left: 75px;
    width: calc(100% - 75px);
  }

  .manager-order-card {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .topbar {
    padding: 0 18px;
  }

  .brand-name {
    font-size: 16px;
  }

  .brand-tagline {
    display: none;
  }

  .avatar-button {
    display: none;
  }

  .hero {
    min-height: auto;
    padding: 45px 20px 65px;
  }

  .hero h1 {
    font-size: 46px;
    letter-spacing: -2px;
  }

  .hero-buttons {
    flex-direction: column;
  }

  .hero-stats {
    gap: 20px;
  }

  .hero-food {
    width: 90%;
  }

  .floating-score-card {
    left: -5%;
  }

  .section-container {
    padding: 55px 20px;
  }

  .section-heading {
    display: block;
  }

  .section-heading p {
    margin-top: 12px;
  }

  .process-grid {
    grid-template-columns: 1fr;
  }

  .ai-banner {
    margin: 10px 20px 55px;
    padding: 25px;
    flex-direction: column;
    align-items: flex-start;
  }

  .ai-banner .white-button {
    margin-left: 0;
  }

  .page-container {
    width: calc(100% - 30px);
    padding-top: 35px;
  }

  .menu-header,
  .page-title-row,
  .content-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .menu-header h1,
  .page-title-row h1,
  .content-heading h1 {
    font-size: 30px;
  }

  .food-grid {
    grid-template-columns: 1fr;
  }

  .food-image-wrapper {
    height: 250px;
  }

  .detail-container {
    width: calc(100% - 30px);
  }

  .detail-info {
    padding: 25px;
  }

  .detail-info h1 {
    font-size: 32px;
  }

  .cart-item {
    flex-wrap: wrap;
  }

  .cart-item-info {
    min-width: calc(100% - 110px);
  }

  .quantity-control {
    margin-left: 100px;
  }

  .success-card,
  .analysis-card,
  .review-card,
  .auth-card {
    padding: 25px;
  }

  .bottom-nav {
    gap: 0;
    justify-content: space-around;
  }

  .bottom-nav a {
    min-width: 55px;
  }

  .manager-topbar {
    padding: 17px;
  }

  .manager-topbar h1 {
    font-size: 18px;
  }

  .manager-content {
    padding: 20px 15px 50px;
  }

  .manager-sidebar {
    width: 60px;
    padding-left: 8px;
    padding-right: 8px;
  }

  .manager-main {
    margin-left: 60px;
    width: calc(100% - 60px);
  }

  .metric-grid {
    grid-template-columns: 1fr;
  }

  .manager-food-grid,
  .review-dashboard,
  .analytics-grid {
    grid-template-columns: 1fr;
  }

  .manager-user {
    display: none;
  }

  .sentiment-chart {
    flex-direction: column;
  }

  .fake-chart {
    gap: 8px;
  }
}
