import os
import re
import ast
import json
import numpy as np

from fastapi import FastAPI
from pydantic import BaseModel

app = FastAPI(title="FoodSense AI Sentiment Service")

BASE = os.path.dirname(os.path.abspath(__file__))
MODEL_PATH = os.path.join(BASE, "models", "rnn_model_food_review_analysis.tflite")
VOCAB_PATH = os.path.join(BASE, "models", "food_review_vocab_word_to_idx_dict.txt")

interpreter = None
input_details = None
output_details = None
vocab = {}
AI_MODE = "fallback"


class ReviewRequest(BaseModel):
    text: str
    rating: float | None = None


def load_vocab():

    global vocab

    if not os.path.exists(VOCAB_PATH):
        return

    try:
        text = open(VOCAB_PATH, "r", encoding="utf-8", errors="ignore").read().strip()

        # Try dictionary format
        try:
            obj = ast.literal_eval(text)

            if isinstance(obj, dict):
                vocab = {
                    str(k).lower(): int(v)
                    for k, v in obj.items()
                    if str(v).lstrip("-").isdigit()
                }

                if vocab:
                    return
        except Exception:
            pass

        # Try JSON
        try:
            obj = json.loads(text)

            if isinstance(obj, dict):
                vocab = {
                    str(k).lower(): int(v)
                    for k, v in obj.items()
                    if str(v).lstrip("-").isdigit()
                }

                if vocab:
                    return
        except Exception:
            pass

        # Try line-by-line:
        # word,index
        # word index
        for line in text.splitlines():

            line = line.strip()

            if not line:
                continue

            parts = re.split(r"[\t, ]+", line)

            if len(parts) >= 2:

                word = parts[0].strip().lower()

                try:
                    index = int(parts[-1])
                    vocab[word] = index
                except Exception:
                    continue

    except Exception:
        pass


def load_tflite():

    global interpreter
    global input_details
    global output_details
    global AI_MODE

    if not os.path.exists(MODEL_PATH):
        return

    # Try modern LiteRT package first
    try:
        from ai_edge_litert.interpreter import Interpreter

        interpreter = Interpreter(model_path=MODEL_PATH)
        interpreter.allocate_tensors()

        input_details = interpreter.get_input_details()
        output_details = interpreter.get_output_details()

        AI_MODE = "tflite"

        return
    except Exception:
        pass

    # Try TensorFlow
    try:
        import tensorflow as tf

        interpreter = tf.lite.Interpreter(model_path=MODEL_PATH)
        interpreter.allocate_tensors()

        input_details = interpreter.get_input_details()
        output_details = interpreter.get_output_details()

        AI_MODE = "tflite"

        return
    except Exception:
        pass


def preprocess(text):

    text = text.lower()

    words = re.findall(r"[a-zA-Z0-9']+", text)

    # Common unknown token handling
    unknown = (
        vocab.get("<unk>") or
        vocab.get("unk") or
        vocab.get("<unknown>") or
        vocab.get("unknown") or
        0
    )

    tokens = [
        vocab.get(word, unknown)
        for word in words
    ]

    if not tokens:
        tokens = [unknown]

    # Read model expected shape
    shape = None

    if input_details:
        shape = input_details[0].get("shape")

    # Most sequence models use [batch, sequence]
    if shape is not None and len(shape) >= 2:

        sequence_length = int(shape[-1])

        if sequence_length > 0:

            if len(tokens) > sequence_length:
                tokens = tokens[-sequence_length:]

            if len(tokens) < sequence_length:
                tokens = tokens + [0] * (sequence_length - len(tokens))

    arr = np.array([tokens], dtype=np.int32)

    # Correct dtype if model requests something else
    if input_details:

        dtype = input_details[0].get("dtype")

        if dtype is not None:
            arr = arr.astype(dtype)

    return arr


def predict_tflite(text):

    if interpreter is None:
        return None

    try:

        arr = preprocess(text)

        interpreter.set_tensor(
            input_details[0]["index"],
            arr
        )

        interpreter.invoke()

        output = interpreter.get_tensor(
            output_details[0]["index"]
        )

        values = np.asarray(output).flatten()

        if len(values) == 0:
            return None

        # Binary sentiment
        if len(values) == 1:

            value = float(values[0])

            # sigmoid output
            if value >= 0.5:
                sentiment = "positive"
                confidence = value
            else:
                sentiment = "negative"
                confidence = 1.0 - value

            return {
                "sentiment": sentiment,
                "confidence": round(float(confidence), 4),
                "raw": values.tolist()
            }

        # Multi-class sentiment
        index = int(np.argmax(values))

        labels = [
            "negative",
            "neutral",
            "positive"
        ]

        if len(values) == 2:
            labels = [
                "negative",
                "positive"
            ]

        sentiment = labels[index] if index < len(labels) else "neutral"

        total = float(np.sum(np.exp(values - np.max(values))))

        probabilities = np.exp(values - np.max(values)) / total

        confidence = float(probabilities[index])

        return {
            "sentiment": sentiment,
            "confidence": round(confidence, 4),
            "raw": values.tolist()
        }

    except Exception as e:

        return {
            "error": str(e)
        }


def fallback_predict(text, rating):

    positive_words = {
        "good", "great", "excellent", "amazing",
        "delicious", "love", "loved", "perfect",
        "fresh", "tasty", "nice", "awesome"
    }

    negative_words = {
        "bad", "terrible", "awful", "hate",
        "hated", "poor", "worst", "cold",
        "slow", "dirty", "bland", "disappointing"
    }

    words = set(re.findall(r"[a-zA-Z]+", text.lower()))

    pos = len(words & positive_words)
    neg = len(words & negative_words)

    if rating is not None:

        if rating >= 4:
            pos += 2

        elif rating <= 2:
            neg += 2

    if pos > neg:
        sentiment = "positive"

    elif neg > pos:
        sentiment = "negative"

    else:
        sentiment = "neutral"

    total = max(pos + neg, 1)

    if sentiment == "neutral":
        confidence = 0.60
    else:
        confidence = min(0.98, 0.65 + abs(pos - neg) / 10)

    return {
        "sentiment": sentiment,
        "confidence": round(confidence, 4),
        "mode": "fallback"
    }


@app.on_event("startup")
def startup():

    load_vocab()
    load_tflite()

    print("--------------------------------------------")
    print("FoodSense AI")
    print("--------------------------------------------")
    print("AI mode:", AI_MODE)
    print("Vocabulary:", len(vocab))

    if input_details:
        print("Input:", input_details)

    if output_details:
        print("Output:", output_details)


@app.get("/health")
def health():

    return {
        "status": "ok",
        "aiMode": AI_MODE,
        "modelExists": os.path.exists(MODEL_PATH),
        "vocabularySize": len(vocab)
    }


@app.post("/predict")
def predict(request: ReviewRequest):

    if AI_MODE == "tflite":

        result = predict_tflite(
            request.text
        )

        if result and "sentiment" in result:

            result["mode"] = "tflite"

            return result

    return fallback_predict(
        request.text,
        request.rating
    )
